<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= yield(:title) || 'My App' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f7f8fa }
    .card { border-radius: 12px }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
    <div class="container-fluid">
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link" href="/kettles">Чайники</a></li>
          <li class="nav-item"><a class="nav-link" href="/producers">Виробники</a></li>
          <li class="nav-item"><a class="nav-link" href="/types">Типи</a></li>
          <li class="nav-item"><a class="nav-link" href="/colors">Кольори</a></li>
          <li class="nav-item"><a class="nav-link" href="/materials">Матеріали</a></li>
        </ul>
        <div class="d-flex">
          <% if authenticated? %>
            <a class="btn btn-outline-primary me-2" href="/auth/change_password">Змінити пароль</a>
            <a class="btn btn-outline-primary" href="/auth/logout">Вийти</a>
          <% else %>
            <a class="btn btn-outline-primary" href="/auth/login">Увійти</a>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <%= yield %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
