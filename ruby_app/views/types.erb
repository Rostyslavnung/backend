<% content_for :title do %>Типи чайників<% end %>

<div class="container py-4">
  <% if flash.any? %>
    <div class="container mb-3">
      <% flash.each do |category, message| %>
        <div class="alert alert-<%= category == :success ? 'success' : 'warning' %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="card p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="mb-0">Список типів чайників</h5>
    </div>

    <% if @types && @types.all.any? %>
      <ul class="list-group">
        <% @types.all.each do |t| %>
          <li class="list-group-item"><%= t.name %></li>
        <% end %>
      </ul>
    <% else %>
      <div class="alert alert-warning">Нічого не знайдено</div>
    <% end %>
  </div>
</div>
