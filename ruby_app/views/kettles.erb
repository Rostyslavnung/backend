<% content_for :title do %>Чайники<% end %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<div class="container py-4">
  <div class="card p-3">
    <h5 class="mb-3">Список чайників</h5>
    <% if @kettles && @kettles.all.any? %>
      <ul class="list-group">
        <% @kettles.all.each do |k| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
              <%= k.model_code %>
              <%= k.name %>
              <% if k.producer_name %>
                <span class="text-muted"> - <%= k.producer_name %></span>
              <% end %>
            </div>
            <button class="btn btn-sm btn-outline-info" data-kettle='<%= k.to_hash.to_json %>' onclick="openDetailsModal(this)" data-bs-toggle="modal" data-bs-target="#detailsModal">
              <i class="bi bi-info-circle"></i>
            </button>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="alert alert-warning">Нічого не знайдено</div>
    <% end %>
  </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="detailsModalLabel">Деталі чайника</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрити"></button>
      </div>
      <div class="modal-body">
        <dl class="row">
          <dt class="col-sm-4">Модель:</dt>
          <dd class="col-sm-8" id="d_model">-</dd>
          <dt class="col-sm-4">Назва:</dt>
          <dd class="col-sm-8" id="d_name">-</dd>
          <dt class="col-sm-4">Ціна:</dt>
          <dd class="col-sm-8" id="d_price">-</dd>
          <dt class="col-sm-4">Виробник:</dt>
          <dd class="col-sm-8" id="d_producer">-</dd>
          <dt class="col-sm-4">Тип:</dt>
          <dd class="col-sm-8" id="d_type">-</dd>
          <dt class="col-sm-4">Колір:</dt>
          <dd class="col-sm-8" id="d_color">-</dd>
          <dt class="col-sm-4">Матеріал:</dt>
          <dd class="col-sm-8" id="d_material">-</dd>
          <dt class="col-sm-4"><%= "Об'єм:" %></dt>
          <dd class="col-sm-8" id="d_capacity">-</dd>
          <dt class="col-sm-4">Гарантія:</dt>
          <dd class="col-sm-8" id="d_warranty">-</dd>
        </dl>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрити</button>
      </div>
    </div>
  </div>
</div>

<script>
  function openDetailsModal(button) {
    const data = button.dataset.kettle;
    if (!data) return;
    const k = JSON.parse(data);
    
    document.getElementById('detailsModalLabel').textContent = k.name || 'Деталі чайника';
    document.getElementById('d_model').textContent = k.model_code || '-';
    document.getElementById('d_name').textContent = k.name || '-';
    document.getElementById('d_price').textContent = (k.price !== undefined && k.price !== null) ? k.price + ' грн.' : '-';
    document.getElementById('d_producer').textContent = k.producer_name || '-';
    document.getElementById('d_type').textContent = k.type_name || '-';
    document.getElementById('d_color').textContent = k.color_name || '-';
    document.getElementById('d_material').textContent = k.material_name || '-';
    document.getElementById('d_capacity').textContent = k.capacity ? k.capacity + ' л.' : '-';
    document.getElementById('d_warranty').textContent = k.warranty_months ? k.warranty_months + ' міс.' : '-';
  }
</script>
